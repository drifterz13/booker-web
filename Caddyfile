{
	admin off
}

:3000 {
	root * /srv
	encode zstd gzip

	# Vite assets have content hashes; missing assets must return 404.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Keep the entry page fresh and support direct visits to client routes.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
